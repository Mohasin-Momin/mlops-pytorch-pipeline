# Serving image - slim base, inference-only deps, non-root user, HEALTHCHECK.
#
# The trained checkpoint is NOT baked into the image. It is mounted at
# /app/checkpoints at run time (a Docker volume locally, the checkpoints PVC on
# Kubernetes), since the model is an artifact that changes independently of the
# serving code and should not need an image rebuild.

# Stage 1: install inference dependencies
FROM python:3.11-slim AS base
WORKDIR /app
COPY requirements/serve.txt .
RUN pip install --no-cache-dir -r serve.txt

# Stage 2: serving runtime
FROM base AS serving
COPY src/ ./src/

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    CHECKPOINT_PATH=/app/checkpoints/classifier_v1.pt

# Non-root user; pre-create the checkpoint mount point so it is writable-owned.
RUN useradd --create-home --uid 1000 appuser \
    && mkdir -p /app/checkpoints \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8080

# /health returns 200 only once the checkpoint has loaded.
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health', timeout=3)" || exit 1

CMD ["uvicorn", "serve:app", "--host", "0.0.0.0", "--port", "8080"]
